generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Country {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  latitude    Float?
  longitude   Float?
  seo         String?
  image       String?
  comments    CountryComment[]
  likes       CountryLike[]
  landings    Landing[]
  regions     Region[]
  takeoffs    Takeoff[]
}

model Region {
  id          Int             @id @default(autoincrement())
  name        String
  countryId   Int
  bestSeason  Int[]
  description String?
  latitude    Float?
  longitude   Float?
  map         String?
  seo         String?
  landings    Landing[]       @relation("LandingRegion")
  country     Country         @relation(fields: [countryId], references: [id])
  comments    RegionComment[]
  likes       RegionLike[]
  takeoffs    Takeoff[]       @relation("TakeoffRegion")
}

model Takeoff {
  id          Int              @id @default(autoincrement())
  name        String
  latitude    Float
  longitude   Float
  altitude    Float
  wind        String?
  description String?
  regionId    Int
  countryId   Int
  map         String?
  seo         String?
  country     Country          @relation(fields: [countryId], references: [id])
  region      Region           @relation("TakeoffRegion", fields: [regionId], references: [id])
  comments    TakeoffComment[]
  likes       TakeoffLike[]
}

model Landing {
  id          Int              @id @default(autoincrement())
  name        String
  latitude    Float
  longitude   Float
  altitude    Float
  description String?
  regionId    Int
  countryId   Int
  map         String?
  seo         String?
  country     Country          @relation(fields: [countryId], references: [id])
  region      Region           @relation("LandingRegion", fields: [regionId], references: [id])
  comments    LandingComment[]
  likes       LandingLike[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                  String              @id
  name                String
  email               String              @unique
  emailVerified       Boolean             @default(false)
  image               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @default(now()) @updatedAt
  bdate               DateTime?
  userType            UserType            @default(Pilot)
  deletedAt           DateTime?
  commentLikes        CommentLike[]
  countryComments     CountryComment[]
  countryLikes        CountryLike[]
  landingComments     LandingComment[]
  landingLikes        LandingLike[]
  passwordResetTokens PasswordResetToken?
  profile             Profile?
  profileLikes        ProfileLike[]
  regionComments      RegionComment[]
  regionLikes         RegionLike[]
  takeoffComments     TakeoffComment[]
  takeoffLikes        TakeoffLike[]
  videoComments       VideoComment[]
  videoLikes          VideoLike[]
  accounts            Account[]
  sessions            Session[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model CountryLike {
  id        Int      @id @default(autoincrement())
  userId    String
  countryId Int
  createdAt DateTime @default(now())
  country   Country  @relation(fields: [countryId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, countryId])
}

model RegionLike {
  id        Int      @id @default(autoincrement())
  userId    String
  regionId  Int
  createdAt DateTime @default(now())
  region    Region   @relation(fields: [regionId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, regionId])
}

model TakeoffLike {
  id        Int      @id @default(autoincrement())
  userId    String
  takeoffId Int
  createdAt DateTime @default(now())
  takeoff   Takeoff  @relation(fields: [takeoffId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, takeoffId])
}

model LandingLike {
  id        Int      @id @default(autoincrement())
  userId    String
  landingId Int
  createdAt DateTime @default(now())
  landing   Landing  @relation(fields: [landingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, landingId])
}

model ProfileLike {
  id        Int      @id @default(autoincrement())
  userId    String
  profileId Int
  createdAt DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, profileId])
}

model VideoLike {
  id        Int      @id @default(autoincrement())
  userId    String
  videoId   Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  video     Video    @relation(fields: [videoId], references: [id])

  @@unique([userId, videoId])
}

model CountryComment {
  id         Int       @id @default(autoincrement())
  userId     String
  countryId  Int
  comment    String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  raport     Int       @default(0)
  reportedBy String[]  @default([])
  profileId  Int
  country    Country   @relation(fields: [countryId], references: [id])
  user       User      @relation(fields: [userId], references: [id])
}

model RegionComment {
  id         Int       @id @default(autoincrement())
  userId     String
  regionId   Int
  comment    String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  raport     Int       @default(0)
  reportedBy String[]  @default([])
  profileId  Int
  region     Region    @relation(fields: [regionId], references: [id])
  user       User      @relation(fields: [userId], references: [id])
}

model TakeoffComment {
  id         Int       @id @default(autoincrement())
  userId     String
  takeoffId  Int
  comment    String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  raport     Int       @default(0)
  reportedBy String[]  @default([])
  profileId  Int
  takeoff    Takeoff   @relation(fields: [takeoffId], references: [id])
  user       User      @relation(fields: [userId], references: [id])
}

model LandingComment {
  id         Int       @id @default(autoincrement())
  userId     String
  landingId  Int
  comment    String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  raport     Int       @default(0)
  reportedBy String[]  @default([])
  profileId  Int
  landing    Landing   @relation(fields: [landingId], references: [id])
  user       User      @relation(fields: [userId], references: [id])
}

model Profile {
  id             Int            @id @default(autoincrement())
  userId         String         @unique
  public         Boolean        @default(false)
  raport         Int            @default(0)
  name           String
  sex            String?
  url            String         @unique
  bdate          DateTime
  bio            String?
  createdAt      DateTime       @default(now())
  image          String?        @unique
  showAge        Boolean        @default(false)
  canPM          Boolean        @default(false)
  user           User           @relation(fields: [userId], references: [id])
  like           ProfileLike[]
  videos         Video[]
  videosComments VideoComment[]
}

model Video {
  id        Int            @id @default(autoincrement())
  profileId Int
  userId    String
  url       String         @unique
  reported  Int            @default(0)
  createdAt DateTime       @default(now())
  deleted   DateTime?      @db.Timestamptz(6)
  name      String
  profile   Profile        @relation(fields: [profileId], references: [id])
  comments  VideoComment[]
  likes     VideoLike[]
}

model CommentLike {
  id        Int         @id @default(autoincrement())
  userId    String
  commentId Int
  type      CommentType
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id])

  @@unique([userId, commentId, type])
}

model VideoComment {
  id        Int       @id @default(autoincrement())
  userId    String
  profileId Int
  videoId   Int
  comment   String
  raport    Int       @default(0)
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  profile   Profile   @relation(fields: [profileId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  video     Video     @relation(fields: [videoId], references: [id])
}

enum UserType {
  Admin
  Pilot
}

enum CommentType {
  Country
  Region
  Takeoff
  Landing
}
